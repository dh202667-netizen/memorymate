{
  "name": "memorymate-mobile",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pages:generate": "node scripts/generate-pages.mjs",
    "pages:check": "node scripts/generate-pages.mjs --check",
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "check": "npm run pages:check && npm run type-check",
    "release:web": "npm run check && npm run build:h5 && node scripts/prepare-web.mjs",
    "prepare:github": "node scripts/prepare-github-pages.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "3.4.21",
    "@types/node": "22.10.2",
    "sass": "1.77.8",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  }
}
